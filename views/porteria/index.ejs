<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="theme-color" content="#0a1a14">
  <title>Portería — SGAR</title>
  <link rel="manifest" href="/static/porteria/manifest.json">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/static/porteria/css/porteria.css">
</head>
<body>

<!-- ─── PANTALLA LOGIN ───────────────────────────────────────────────────────── -->
<div id="screen-login" class="screen active">
  <div class="login-bg">
    <div class="login-mesh"></div>
    <div class="login-grid"></div>
    <div class="login-particles" id="login-particles"></div>
  </div>
  <div class="login-wrap">
    <div class="login-brand">
      <div class="login-brand-logo">
        <svg viewBox="0 0 24 24" width="30" height="30" fill="#fff">
          <path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4z"/>
        </svg>
      </div>
      <h1 class="login-brand-title">Portería</h1>
      <p class="login-brand-sub">SGAR · Control de acceso</p>
    </div>
    <div class="login-card">
      <div id="login-error" class="login-alert" style="display:none"></div>
      <div class="login-field">
        <label>Correo electrónico</label>
        <div class="login-input-wrap">
          <svg class="login-input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
          </svg>
          <input class="login-input" type="email" id="login-email" placeholder="celador@ejemplo.com" autocomplete="email">
        </div>
      </div>
      <div class="login-field">
        <label>Contraseña</label>
        <div class="login-input-wrap">
          <svg class="login-input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>
          </svg>
          <input class="login-input" type="password" id="login-pwd" placeholder="••••••••" autocomplete="current-password">
        </div>
      </div>
      <button class="login-btn" id="btn-login">Iniciar sesión</button>
    </div>
    <p class="login-footer">SGAR · ADSO 3142784</p>
  </div>
</div>

<!-- ─── PANTALLA PRINCIPAL (ACCIÓN) ──────────────────────────────────────────── -->
<div id="screen-main" class="screen">
  <!-- Header -->
  <header class="app-header">
    <div class="header-left">
      <div class="conn-indicator" id="conn-indicator" title="Estado de conexión">
        <span class="conn-dot" id="conn-dot"></span>
        <span class="conn-label" id="conn-label">Online</span>
      </div>
    </div>
    <div class="header-center">
      <span id="conjunto-nombre">Portería</span>
    </div>
    <div class="header-right">
      <button class="icon-btn" id="btn-menu" title="Menú">
        <svg viewBox="0 0 24 24" width="22" height="22" stroke="currentColor" fill="none" stroke-width="2">
          <line x1="3" y1="6" x2="21" y2="6"/>
          <line x1="3" y1="12" x2="21" y2="12"/>
          <line x1="3" y1="18" x2="21" y2="18"/>
        </svg>
      </button>
    </div>
  </header>

  <!-- 3 Botones principales -->
  <main class="action-main">
    <div class="action-grid">
      <button class="action-btn btn-visita" id="btn-visita">
        <svg viewBox="0 0 24 24" width="36" height="36" stroke="currentColor" fill="none" stroke-width="1.5">
          <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
          <circle cx="12" cy="7" r="4"/>
        </svg>
        <span>Registrar Visita</span>
      </button>

      <button class="action-btn btn-domicilio" id="btn-domicilio">
        <svg viewBox="0 0 24 24" width="36" height="36" stroke="currentColor" fill="none" stroke-width="1.5">
          <rect x="1" y="3" width="15" height="13"/>
          <path d="M16 8h4l3 3v5h-7V8z"/>
          <circle cx="5.5" cy="18.5" r="2.5"/>
          <circle cx="18.5" cy="18.5" r="2.5"/>
        </svg>
        <span>Registrar Domicilio</span>
      </button>

      <button class="action-btn btn-placa" id="btn-placa">
        <svg viewBox="0 0 24 24" width="36" height="36" stroke="currentColor" fill="none" stroke-width="1.5">
          <rect x="2" y="7" width="20" height="10" rx="2"/>
          <path d="M5 7v2M19 7v2"/>
          <text x="12" y="15" text-anchor="middle" stroke="none" fill="currentColor" font-size="6" font-weight="bold">ABC</text>
        </svg>
        <span>Escanear Placa</span>
      </button>
    </div>

    <!-- Últimos 3 registros del turno -->
    <section class="recent-strip">
      <div class="recent-header">
        <span class="recent-title">Últimos registros</span>
        <button class="link-btn" id="btn-ver-historial">Ver todo</button>
      </div>
      <div id="recent-list">
        <div class="empty-recent">Sin registros en este turno</div>
      </div>
    </section>

    <!-- Cola de sincronización pendiente -->
    <div id="sync-banner" class="sync-banner" style="display:none">
      <span id="sync-count">0 registros pendientes de sincronización</span>
      <button class="btn-sync" id="btn-sync">Sincronizar ahora</button>
    </div>
  </main>
</div>

<!-- ─── PANTALLA HISTORIAL ────────────────────────────────────────────────────── -->
<div id="screen-historial" class="screen">
  <header class="app-header">
    <button class="icon-btn" id="btn-back-historial">
      <svg viewBox="0 0 24 24" width="22" height="22" stroke="currentColor" fill="none" stroke-width="2">
        <polyline points="15 18 9 12 15 6"/>
      </svg>
    </button>
    <div class="header-center">Historial del turno</div>
    <div class="header-right"></div>
  </header>
  <main class="list-main">
    <div id="historial-list">
      <div class="empty-recent" style="padding:40px 16px">Sin registros aún</div>
    </div>
  </main>
</div>

<!-- ─── PANTALLA ANALÍTICAS ──────────────────────────────────────────────────── -->
<div id="screen-analiticas" class="screen">
  <header class="app-header">
    <button class="icon-btn" id="btn-back-analiticas">
      <svg viewBox="0 0 24 24" width="22" height="22" stroke="currentColor" fill="none" stroke-width="2">
        <polyline points="15 18 9 12 15 6"/>
      </svg>
    </button>
    <div class="header-center">Analíticas</div>
    <div class="header-right"></div>
  </header>
  <main class="list-main">
    <div id="analytics-porteria"></div>
  </main>
</div>

<!-- ─── SIDE MENU ─────────────────────────────────────────────────────────────── -->
<div class="menu-overlay" id="menu-overlay"></div>
<nav class="side-menu" id="side-menu">
  <div class="menu-header">
    <div class="menu-avatar" id="menu-avatar">C</div>
    <div>
      <div class="menu-name" id="menu-name">Celador</div>
      <div class="menu-conjunto" id="menu-conjunto">Conjunto</div>
    </div>
  </div>
  <ul class="menu-list">
    <li><button class="menu-item" onclick="navigate('main')">
      <svg viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" fill="none" stroke-width="2">
        <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
      </svg>Inicio</button></li>
    <li><button class="menu-item" onclick="navigate('historial')">
      <svg viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" fill="none" stroke-width="2">
        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
        <polyline points="14 2 14 8 20 8"/>
      </svg>Historial del turno</button></li>
    <li><button class="menu-item" onclick="navigate('analiticas')">
      <svg viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" fill="none" stroke-width="2">
        <line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/>
      </svg>Analíticas</button></li>
  </ul>
  <div class="menu-footer">
    <button class="menu-item menu-logout" id="btn-logout">
      <svg viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" fill="none" stroke-width="2">
        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
        <polyline points="16 17 21 12 16 7"/>
        <line x1="21" y1="12" x2="9" y2="12"/>
      </svg>Cerrar sesión</button>
  </div>
</nav>

<!-- ─── BOTTOM DRAWER (formularios) ──────────────────────────────────────────── -->
<div class="drawer-overlay" id="drawer-overlay"></div>
<div class="bottom-drawer" id="bottom-drawer">
  <div class="drawer-handle"></div>
  <div class="drawer-header">
    <h2 class="drawer-title" id="drawer-title">Registrar</h2>
    <button class="drawer-close" id="drawer-close">✕</button>
  </div>
  <div class="drawer-body" id="drawer-body">
    <!-- Contenido dinámico según acción -->
  </div>
</div>

<!-- Scripts -->
<script src="https://unpkg.com/dexie@3.2.4/dist/dexie.min.js"></script>
<script src="/static/porteria/js/db.js"></script>
<script src="/static/porteria/js/api.js"></script>
<script src="/static/porteria/js/porteria.js"></script>
<script>
// Generate login particles
(function() {
  const c = document.getElementById('login-particles');
  if (!c) return;
  for (let i = 0; i < 25; i++) {
    const p = document.createElement('div');
    p.className = 'login-particle';
    p.style.left = Math.random() * 100 + '%';
    p.style.animationDuration = (8 + Math.random() * 14) + 's';
    p.style.animationDelay = (Math.random() * 8) + 's';
    p.style.width = p.style.height = (1 + Math.random() * 2) + 'px';
    c.appendChild(p);
  }
})();
</script>
</body>
</html>
