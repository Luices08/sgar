<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="theme-color" content="#2563eb">
  <link rel="icon" type="image/svg+xml" href="/static/shared/img/app-icon.svg">
  <title>Portería — SGAR</title>
  <link rel="manifest" href="/static/porteria/manifest.json">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/static/porteria/css/porteria.css">
  <link rel="stylesheet" href="/static/porteria/css/facial.css">
</head>
<body>

<!-- ─── PANTALLA PRINCIPAL (ACCIÓN) ──────────────────────────────────────────── -->
<div id="screen-main" class="screen active">
  <!-- Header -->
  <header class="app-header">
    <div class="header-left">
      <button class="icon-btn" id="btn-menu" title="Menú lateral">
        <svg viewBox="0 0 24 24" width="22" height="22" stroke="currentColor" fill="none" stroke-width="2">
          <line x1="3" y1="6" x2="21" y2="6"/>
          <line x1="3" y1="12" x2="21" y2="12"/>
          <line x1="3" y1="18" x2="21" y2="18"/>
        </svg>
      </button>
    </div>
    <div class="header-center">
      <span id="conjunto-nombre">Portería</span>
    </div>
    <div class="header-right">
      <div class="conn-indicator" id="conn-indicator" title="Estado de conexión">
        <span class="conn-dot" id="conn-dot"></span>
        <span class="conn-label" id="conn-label">Online</span>
      </div>
    </div>
  </header>

  <!-- 3 Botones principales -->
  <main class="action-main" style="padding-top: 24px;">

    <div class="action-grid-rows">
      <!-- Fila 1: Residentes (2 botones) -->
      <div class="action-grid-row action-grid-row-2">
        <!-- 1. Registrar ENTRADA de Residente -->
        <div class="action-group">
          <button class="action-btn btn-facial btn-entrada-residente" id="btn-registro-residente">
            <span class="action-btn-icon">
              <svg viewBox="0 0 24 24" width="24" height="24" stroke="currentColor" fill="none" stroke-width="1.6">
                <path d="M9 3H5a2 2 0 0 0-2 2v4"/>
                <path d="M15 3h4a2 2 0 0 1 2 2v4"/>
                <path d="M9 21H5a2 2 0 0 1-2-2v-4"/>
                <path d="M15 21h4a2 2 0 0 0 2-2v-4"/>
                <circle cx="12" cy="10" r="3"/>
                <path d="M7 21v-1a5 5 0 0 1 10 0v1"/>
              </svg>
            </span>
            <div class="action-btn-bottom">
              <span class="action-btn-text">
                <strong>Entrada de Residente</strong>
                <small>Reconocimiento facial o ingreso manual.</small>
              </span>
              <span class="action-btn-arrow">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
              </span>
            </div>
          </button>
          <button class="action-btn-offline" id="btn-manual-residente" title="Registro Manual (Offline)">
            <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" fill="none" stroke-width="2.5"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
          </button>
        </div>

        <!-- 2. Registrar SALIDA de Residente -->
        <div class="action-group">
          <button class="action-btn btn-salida-residente" id="btn-salida-residente">
            <span class="active-residents-badge" id="badge-residentes-dentro" style="display:none">0 adentro</span>
            <span class="action-btn-icon">
              <svg viewBox="0 0 24 24" width="24" height="24" stroke="currentColor" fill="none" stroke-width="1.6">
                <path d="M9 3H5a2 2 0 0 0-2 2v4"/>
                <path d="M15 3h4a2 2 0 0 1 2 2v4"/>
                <path d="M9 21H5a2 2 0 0 1-2-2v-4"/>
                <path d="M15 21h4a2 2 0 0 0 2-2v-4"/>
                <polyline points="16 17 21 12 16 7"/>
                <line x1="21" y1="12" x2="9" y2="12"/>
              </svg>
            </span>
            <div class="action-btn-bottom">
              <span class="action-btn-text">
                <strong>Salida de Residente</strong>
                <small>Ver y registrar salida de residentes dentro.</small>
              </span>
              <span class="action-btn-arrow">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
              </span>
            </div>
          </button>
          <button class="action-btn-offline" id="btn-scan-salida-residente" title="Escanear Rostro Salida">
            <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" fill="none" stroke-width="2.5"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg>
          </button>
        </div>
      </div>

      <!-- Fila 2: Visitas y Domicilios (3 botones) -->
      <div class="action-grid-row action-grid-row-3">
        <!-- 3. Registrar ENTRADA de Visitante -->
        <div class="action-group">
          <button class="action-btn btn-visita" id="btn-registro-visita">
            <span class="pending-invitations-badge" id="badge-invitaciones-pendientes" style="display:none">0 pendientes</span>
            <span class="action-btn-icon">
              <svg viewBox="0 0 24 24" width="24" height="24" stroke="currentColor" fill="none" stroke-width="1.6">
                <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                <circle cx="8.5" cy="7" r="4"/>
                <polyline points="17 11 19 13 23 9"/>
              </svg>
            </span>
            <div class="action-btn-bottom">
              <span class="action-btn-text">
                <strong>Entrada de Visitante</strong>
                <small>Verificar código o registrar ingreso.</small>
              </span>
              <span class="action-btn-arrow">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
              </span>
            </div>
          </button>
          <button class="action-btn-offline" id="btn-manual-visita" title="Registro Manual (Offline)">
            <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" fill="none" stroke-width="2.5"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
          </button>
        </div>

        <!-- 4. Registrar SALIDA de Visitante -->
        <div class="action-group">
          <button class="action-btn btn-salida" id="btn-salida-visita">
            <span class="active-visitors-badge" id="badge-visitantes-dentro" style="display:none">0 adentro</span>
            <span class="action-btn-icon">
              <svg viewBox="0 0 24 24" width="24" height="24" stroke="currentColor" fill="none" stroke-width="1.6">
                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
                <polyline points="16 17 21 12 16 7"/>
                <line x1="21" y1="12" x2="9" y2="12"/>
              </svg>
            </span>
            <div class="action-btn-bottom">
              <span class="action-btn-text">
                <strong>Salida de Visitante</strong>
                <small>Ver y registrar salida de visitantes dentro.</small>
              </span>
              <span class="action-btn-arrow">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
              </span>
            </div>
          </button>
          <button class="action-btn-offline" id="btn-manual-salida-visita" title="Ver Salidas de Visitantes">
            <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" fill="none" stroke-width="2.5"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
          </button>
        </div>

        <!-- 5. Registrar Domicilio -->
        <div class="action-group">
          <button class="action-btn btn-domicilio" id="btn-registro-domicilio">
            <span class="action-btn-icon">
              <svg viewBox="0 0 24 24" width="24" height="24" stroke="currentColor" fill="none" stroke-width="1.6">
                <rect x="1" y="3" width="15" height="13"/>
                <path d="M16 8h4l3 3v5h-7V8z"/>
                <circle cx="5.5" cy="18.5" r="2.5"/>
                <circle cx="18.5" cy="18.5" r="2.5"/>
              </svg>
            </span>
            <div class="action-btn-bottom">
              <span class="action-btn-text">
                <strong>Registrar Domicilio</strong>
                <small>Registra la entrada de domicilios y entregas.</small>
              </span>
              <span class="action-btn-arrow">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
              </span>
            </div>
          </button>
          <button class="action-btn-offline" id="btn-manual-domicilio" title="Registro Manual (Offline)">
            <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" fill="none" stroke-width="2.5"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
          </button>
        </div>
      </div>
    </div>

    <!-- Últimos 10 registros del turno -->
    <section class="recent-strip">
      <div class="recent-header">
        <span class="recent-title">Últimos registros</span>
        <button class="link-btn" id="btn-ver-historial">Ver todo</button>
      </div>
      <div id="recent-list">
        <div class="empty-recent">Sin registros en este turno</div>
      </div>
    </section>

    <!-- Cola de sincronización pendiente -->
    <div id="sync-banner" class="sync-banner" style="display:none">
      <span id="sync-count">0 registros pendientes de sincronización</span>
      <button class="btn-sync" id="btn-sync">Sincronizar ahora</button>
    </div>
  </main>
</div>

<!-- ─── PANTALLA HISTORIAL ────────────────────────────────────────────────────── -->
<div id="screen-historial" class="screen">
  <header class="app-header">
    <button class="icon-btn" id="btn-back-historial">
      <svg viewBox="0 0 24 24" width="22" height="22" stroke="currentColor" fill="none" stroke-width="2">
        <polyline points="15 18 9 12 15 6"/>
      </svg>
    </button>
    <div class="header-center" id="historial-title">Historial de Accesos</div>
    <div class="header-right"></div>
  </header>

  <!-- Selector de Pestañas: Hoy vs Completo -->
  <div style="display:flex; background:var(--white); border-bottom:1px solid var(--border); padding:8px 14px; gap:8px;">
    <button id="tab-historial-hoy" style="flex:1; padding:8px 12px; border-radius:var(--radius); border:none; font-weight:600; font-size:14px; cursor:pointer; background:var(--acento); color:#fff; transition:all .15s;">Historial de hoy</button>
    <button id="tab-historial-completo" style="flex:1; padding:8px 12px; border-radius:var(--radius); border:none; font-weight:600; font-size:14px; cursor:pointer; background:var(--bg); color:var(--text-muted); transition:all .15s;">Historial completo</button>
  </div>

  <main class="list-main">
    <div id="historial-list">
      <div class="empty-recent" style="padding:40px 16px">Sin registros aún</div>
    </div>
    <div id="historial-pagination" style="display:none; padding:16px 14px 30px; text-align:center;">
      <button id="btn-cargar-mas-historial" class="btn-action-secondary" style="width:100%; padding:12px 16px; font-weight:600;">
        Cargar más registros (20)
      </button>
    </div>
  </main>
</div>

<!-- ─── PANTALLA ANALÍTICAS ──────────────────────────────────────────────────── -->
<div id="screen-analiticas" class="screen">
  <header class="app-header">
    <button class="icon-btn" id="btn-back-analiticas">
      <svg viewBox="0 0 24 24" width="22" height="22" stroke="currentColor" fill="none" stroke-width="2">
        <polyline points="15 18 9 12 15 6"/>
      </svg>
    </button>
    <div class="header-center">Analíticas</div>
    <div class="header-right"></div>
  </header>
  <main class="list-main">
    <div id="analytics-porteria"></div>
  </main>
</div>

<!-- ─── PANTALLA VISITAS (CENTRO DE CONTROL) ─────────────────────────────────── -->
<div id="screen-visitas" class="screen">
  <header class="app-header">
    <button class="icon-btn" id="btn-back-visitas">
      <svg viewBox="0 0 24 24" width="22" height="22" stroke="currentColor" fill="none" stroke-width="2">
        <polyline points="15 18 9 12 15 6"/>
      </svg>
    </button>
    <div class="header-center">Control de Visitas</div>
    <div class="header-right"></div>
  </header>

  <main class="list-main">

    <!-- ZONA 1: Verificar código de invitación -->
    <div class="recent-strip">
      <div class="recent-header">
        <span class="recent-title">Verificar Código</span>
      </div>
      <div style="padding: 16px;">
        <input
          type="text"
          id="codigo-input"
          class="form-field"
          placeholder="Escribe el código"
          maxlength="6"
          autocomplete="off"
          inputmode="numeric"
          style="display:block; width:100%; padding:18px 14px; font-size:2rem; font-family:monospace; letter-spacing:14px; text-align:center; border:1px solid var(--border); border-radius:var(--radius); outline:none; transition:border-color .15s; background:var(--bg);"
        >
        <button id="btn-verificar" class="btn-action" style="margin-top:12px;">
          Verificar e Ingresar
        </button>
        <button id="btn-manual-visita-online" class="btn-action-secondary" style="margin-top:8px;">
          Visita No Esperada
        </button>
      </div>
    </div>

    <!-- ZONA 2: Invitaciones pendientes -->
    <div class="recent-strip">
      <div class="recent-header">
        <span class="recent-title">Invitaciones en Espera</span>
        <button class="link-btn" id="btn-refresh-invitations" title="Actualizar">
          <svg viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" fill="none" stroke-width="2.5"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/></svg>
          Actualizar
        </button>
      </div>
      <div style="padding: 12px 14px 6px;">
        <div style="position:relative;">
          <input
            type="text"
            id="search-invitations"
            placeholder="Filtrar por apto o nombre…"
            style="width:100%; padding:9px 14px; border:1px solid var(--border); border-radius:var(--radius); font-size:14px; outline:none; background:var(--white); transition:border-color .15s;"
          >
        </div>
      </div>
      <div id="cards-container" style="padding: 0 14px 14px;">
        <!-- Tarjetas dinámicas -->
      </div>
    </div>

  </main>
</div>

<!-- ─── PANTALLA SALIDAS DE VISITANTES ──────────────────────────────────────── -->
<div id="screen-salidas-visitas" class="screen">
  <header class="app-header">
    <button class="icon-btn" id="btn-back-salidas-visitas">
      <svg viewBox="0 0 24 24" width="22" height="22" stroke="currentColor" fill="none" stroke-width="2">
        <polyline points="15 18 9 12 15 6"/>
      </svg>
    </button>
    <div class="header-center">Salida de Visitantes</div>
    <div class="header-right"></div>
  </header>

  <main class="list-main">
    <div class="recent-strip">
      <div class="recent-header">
        <span class="recent-title">Visitantes en el Conjunto</span>
        <button class="link-btn" id="btn-refresh-salidas" title="Actualizar">
          <svg viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" fill="none" stroke-width="2.5"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/></svg>
          Actualizar
        </button>
      </div>
      <div style="padding: 12px 14px 6px;">
        <div style="position:relative;">
          <input
            type="text"
            id="search-salidas"
            placeholder="Filtrar por nombre, cédula o apto…"
            style="width:100%; padding:9px 14px; border:1px solid var(--border); border-radius:var(--radius); font-size:14px; outline:none; background:var(--white); transition:border-color .15s;"
          >
        </div>
      </div>
      <div id="salidas-cards-container" style="padding: 0 14px 14px;">
        <!-- Tarjetas dinámicas de visitantes adentro -->
      </div>
    </div>
  </main>
</div>

<!-- ─── PANTALLA SALIDAS DE RESIDENTES ──────────────────────────────────────── -->
<div id="screen-salidas-residentes" class="screen">
  <header class="app-header">
    <button class="icon-btn" id="btn-back-salidas-residentes">
      <svg viewBox="0 0 24 24" width="22" height="22" stroke="currentColor" fill="none" stroke-width="2">
        <polyline points="15 18 9 12 15 6"/>
      </svg>
    </button>
    <div class="header-center">Salida de Residentes</div>
    <div class="header-right"></div>
  </header>

  <main class="list-main">
    <!-- Botón destacado: Escanear rostro para salida -->
    <div style="padding: 14px 14px 4px;">
      <button id="btn-quick-scan-salida" class="btn-action" style="background: linear-gradient(135deg, #7c3aed, #6d28d9); display: flex; align-items: center; justify-content: center; gap: 8px; font-weight: 700;">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M9 3H5a2 2 0 0 0-2 2v4"/>
          <path d="M15 3h4a2 2 0 0 1 2 2v4"/>
          <path d="M9 21H5a2 2 0 0 1-2-2v-4"/>
          <path d="M15 21h4a2 2 0 0 0 2-2v-4"/>
          <circle cx="12" cy="10" r="3"/>
          <path d="M7 21v-1a5 5 0 0 1 10 0v1"/>
        </svg>
        Escanear Rostro para Salida
      </button>
    </div>

    <div class="recent-strip">
      <div class="recent-header">
        <span class="recent-title">Residentes en el Conjunto</span>
        <button class="link-btn" id="btn-refresh-salidas-res" title="Actualizar">
          <svg viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" fill="none" stroke-width="2.5"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/></svg>
          Actualizar
        </button>
      </div>
      <div style="padding: 12px 14px 6px;">
        <div style="position:relative;">
          <input
            type="text"
            id="search-salidas-res"
            placeholder="Filtrar por nombre, cédula o apto…"
            style="width:100%; padding:9px 14px; border:1px solid var(--border); border-radius:var(--radius); font-size:14px; outline:none; background:var(--white); transition:border-color .15s;"
          >
        </div>
      </div>
      <div id="salidas-residentes-cards-container" style="padding: 0 14px 14px;">
        <!-- Tarjetas dinámicas de residentes adentro -->
      </div>
    </div>
  </main>
</div>

<!-- ─── SIDE MENU ─────────────────────────────────────────────────────────────── -->
<div class="menu-overlay" id="menu-overlay"></div>
<nav class="side-menu" id="side-menu">
  <div class="menu-header">
    <div class="menu-avatar" id="menu-avatar">C</div>
    <div>
      <div class="menu-name" id="menu-name">Celador</div>
      <div class="menu-conjunto" id="menu-conjunto">Conjunto</div>
    </div>
  </div>
  <ul class="menu-list">
    <li><button class="menu-item" onclick="navigate('main')">
      <svg viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" fill="none" stroke-width="2">
        <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
      </svg>Inicio</button></li>
    <li><button class="menu-item" onclick="navigate('historial')">
      <svg viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" fill="none" stroke-width="2">
        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
        <polyline points="14 2 14 8 20 8"/>
      </svg>Historial de accesos</button></li>
    <li><button class="menu-item" onclick="navigate('analiticas')">
      <svg viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" fill="none" stroke-width="2">
        <line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/>
      </svg>Analíticas</button></li>
  </ul>
  <div class="menu-footer">
    <button class="menu-item menu-logout" id="btn-logout">
      <svg viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" fill="none" stroke-width="2">
        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
        <polyline points="16 17 21 12 16 7"/>
        <line x1="21" y1="12" x2="9" y2="12"/>
      </svg>Cerrar sesión</button>
  </div>
</nav>

<!-- ─── BOTTOM DRAWER (formularios) ──────────────────────────────────────────── -->
<div class="drawer-overlay" id="drawer-overlay"></div>
<div class="bottom-drawer" id="bottom-drawer">
  <div class="drawer-handle"></div>
  <div class="drawer-header">
    <h2 class="drawer-title" id="drawer-title">Registrar</h2>
    <button class="drawer-close" id="drawer-close">✕</button>
  </div>
  <div class="drawer-body" id="drawer-body">
    <!-- Contenido dinámico según acción -->
  </div>
</div>

<!-- ─── PANTALLA FACIAL (CÁMARA) ─────────────────────────────────────────────── -->
<div id="screen-facial" class="screen">
  <div class="facial-header">
    <button class="facial-back-btn" id="facial-back-btn" title="Volver">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5">
        <polyline points="15 18 9 12 15 6"/>
      </svg>
    </button>
    <span class="facial-header-title">Reconocimiento Facial</span>
    <button class="icon-btn" id="btn-registro-manual" title="Registro Manual" style="color: #fff;">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
        <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
      </svg>
    </button>
  </div>
  <div class="facial-loading-overlay" id="facial-loading-overlay">
    <div class="facial-loading-icon"></div>
    <p class="facial-loading-text" id="facial-loading-text">Inicializando…</p>
  </div>
  <div class="facial-camera-wrap">
    <video id="facial-video" autoplay muted playsinline></video>
    <canvas id="facial-canvas"></canvas>
    <div class="facial-frame">
      <div class="frame-b"></div>
      <div class="scan-line"></div>
    </div>
  </div>
  <div class="facial-status-bar">
    <div class="facial-status-row">
      <div class="facial-status-dot scanning" id="facial-status-dot"></div>
      <span class="facial-status-text" id="facial-status-text">Buscando rostro…</span>
    </div>
    <span class="confidence-chip" id="facial-confidence-chip" style="display:none">—</span>
    <button class="facial-capture-btn" id="facial-capture-btn" title="Capturar ahora">
      <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="12" cy="12" r="3"/>
        <path d="M20.94 11a9 9 0 1 1-9-9 9.07 9.07 0 0 1 9 9z"/>
      </svg>
    </button>
    <p class="facial-manual-hint">Toca para capturar manualmente</p>
  </div>
</div>

<!-- ─── MODAL INGRESO / SALIDA ────────────────────────────────────────────────── -->
<div class="facial-modal-overlay" id="facial-modal-overlay">
  <div class="facial-modal">
    <div class="resident-card">
      <img  class="resident-avatar" id="modal-resident-avatar" src="" alt="" style="display:none">
      <div class="resident-avatar-placeholder" id="modal-resident-avatar-ph">R</div>
      <div class="resident-info">
        <div class="resident-name" id="modal-resident-name">—</div>
        <div class="resident-sub"  id="modal-resident-sub">—</div>
      </div>
      <div class="resident-badge" id="modal-resident-badge" style="display:none">
        <div class="resident-badge-dot"></div>
        <span id="modal-badge-text">—</span>
      </div>
    </div>
    <div id="modal-discrepancy-alert" style="display:none; margin: 10px 0; background: rgba(245, 158, 11, 0.15); border: 1px solid rgba(245, 158, 11, 0.4); color: #fcd34d; padding: 10px 14px; border-radius: 8px; font-size: 13px; font-weight: 600; text-align: left; line-height: 1.4;"></div>
    <p class="action-label" id="modal-action-label">¿Cómo ingresa el residente?</p>
    <div class="mode-grid">
      <button class="mode-btn" id="mode-btn-pie">
        <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.8">
          <path d="M13 4v4l-2 6H7l-2 5h14l-2-5h-4l-2-6"/>
          <circle cx="12" cy="2" r="1.5"/>
        </svg>
        <span>A pie</span>
      </button>
      <button class="mode-btn" id="mode-btn-vehiculo">
        <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.8">
          <rect x="1" y="3" width="15" height="13" rx="2"/>
          <path d="M16 8h4l3 3v5h-7V8z"/>
          <circle cx="5.5" cy="18.5" r="2.5"/>
          <circle cx="18.5" cy="18.5" r="2.5"/>
        </svg>
        <span>En vehículo</span>
      </button>
    </div>

    <!-- Inline Vehicle Selection -->
    <div id="inline-vehicle-section" style="display: none; margin-top: 15px;">
      <div class="vehicle-list" id="facial-vehicle-list"></div>
      <div id="facial-vehicle-other-form" class="facial-other-vehicle-box" style="display:none;">
        <p class="facial-other-title">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
          Datos del vehículo temporal
        </p>
        <div class="facial-input-row">
          <select id="v-otro-tipo" class="facial-dark-select">
            <option value="Carro">Carro</option>
            <option value="Motocicleta">Motocicleta</option>
            <option value="Otro">Otro</option>
          </select>
          <input type="text" id="v-otro-placa" placeholder="PLACA *" class="facial-dark-input placa-field" maxlength="10">
        </div>
        <div class="facial-input-row">
          <input type="text" id="v-otro-marca" placeholder="Marca (Ej. Toyota)" class="facial-dark-input">
          <input type="text" id="v-otro-modelo" placeholder="Modelo (Ej. Corolla)" class="facial-dark-input">
        </div>
      </div>

      <!-- Alerta de vehículo registrado en acceso facial -->
      <div id="box-facial-veh-alert" style="display:none; margin-top:12px;"></div>
      <input type="hidden" id="f-facial-veh-perm-id" value="">
    </div>

    <button class="confirm-btn" id="modal-confirm-btn" disabled>Registrar Ingreso</button>
    <button class="cancel-btn"  id="modal-cancel-btn">Cancelar</button>
  </div>
</div>

<!-- ─── TOAST FACIAL ───────────────────────────────────────────────────────────── -->
<div class="facial-toast" id="facial-toast"></div>

