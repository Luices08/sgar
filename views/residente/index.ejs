<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="theme-color" content="#ffffff">
  <title>Mi Portal — SGAR</title>
  <link rel="manifest" href="/static/residente/manifest.json">
  <link rel="stylesheet" href="/static/residente/css/residente.css">
</head>
<body>


<!-- ─── PANTALLA PRINCIPAL ──────────────────────────────────────────────────── -->
<div id="screen-main" class="screen active">
  <header class="app-header">
    <div class="header-left"></div>
    <div class="header-center" id="header-title">Mi Portal</div>
    <div class="header-right">
      <button class="icon-btn" id="btn-menu">
        <svg viewBox="0 0 24 24" width="22" height="22" stroke="currentColor" fill="none" stroke-width="2">
          <line x1="3" y1="6" x2="21" y2="6"/>
          <line x1="3" y1="12" x2="21" y2="12"/>
          <line x1="3" y1="18" x2="21" y2="18"/>
        </svg>
      </button>
    </div>
  </header>

  <!-- Tab bar -->
  <nav class="tab-bar">
    <button class="tab-btn active" data-tab="notificaciones">
      <svg viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" fill="none" stroke-width="2">
        <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/>
        <path d="M13.73 21a2 2 0 0 1-3.46 0"/>
      </svg>
      <span>Avisos</span>
      <span class="tab-badge" id="badge-notif" style="display:none">0</span>
    </button>
    <button class="tab-btn" data-tab="historial">
      <svg viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" fill="none" stroke-width="2">
        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
        <polyline points="14 2 14 8 20 8"/>
      </svg>
      <span>Historial</span>
    </button>
    <button class="tab-btn" data-tab="invitaciones">
      <svg viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" fill="none" stroke-width="2">
        <rect x="3" y="4" width="18" height="18" rx="2"/>
        <line x1="16" y1="2" x2="16" y2="6"/>
        <line x1="8" y1="2" x2="8" y2="6"/>
        <line x1="3" y1="10" x2="21" y2="10"/>
      </svg>
      <span>Invitaciones</span>
    </button>
  </nav>

  <!-- Contenido de tabs -->
  <main class="tab-content">

    <!-- Tab: Notificaciones -->
    <div id="tab-notificaciones" class="tab-pane active">
      <div class="pane-header">
        <h2 class="pane-title">Avisos de acceso</h2>
        <button class="link-btn" id="btn-mark-read">Marcar todo leído</button>
      </div>
      <div id="notif-list">
        <div class="empty-state-sm">Cargando…</div>
      </div>
    </div>

    <!-- Tab: Historial -->
    <div id="tab-historial" class="tab-pane">
      <div class="pane-header">
        <h2 class="pane-title">Historial de visitas</h2>
        <select id="filter-historial" class="select-sm">
          <option value="">Todos</option>
          <option value="visita">Visitas</option>
          <option value="domicilio">Domicilios</option>
          <option value="vehiculo">Vehículos</option>
        </select>
      </div>
      <div id="historial-list">
        <div class="empty-state-sm">Cargando…</div>
      </div>
    </div>

    <!-- Tab: Invitaciones -->
    <div id="tab-invitaciones" class="tab-pane">
      <div class="pane-header">
        <h2 class="pane-title">Mis invitaciones</h2>
        <button class="btn-action-sm" id="btn-nueva-inv">+ Nueva</button>
      </div>
      <div id="invitaciones-list">
        <div class="empty-state-sm">Cargando…</div>
      </div>
    </div>

  </main>
</div>

<!-- ─── SIDE MENU ───────────────────────────────────────────────────────────── -->
<div class="menu-overlay" id="menu-overlay"></div>
<nav class="side-menu" id="side-menu">
  <div class="menu-header">
    <div class="menu-avatar" id="menu-avatar">R</div>
    <div>
      <div class="menu-name" id="menu-name">Residente</div>
      <div class="menu-apto" id="menu-apto">Apto —</div>
    </div>
  </div>
  <div class="menu-footer">
    <button class="menu-item menu-logout" id="btn-logout">
      <svg viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" fill="none" stroke-width="2">
        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
        <polyline points="16 17 21 12 16 7"/>
        <line x1="21" y1="12" x2="9" y2="12"/>
      </svg>
      Cerrar sesión
    </button>
  </div>
</nav>

<!-- ─── BOTTOM DRAWER (nueva invitación) ──────────────────────────────────── -->
<div class="drawer-overlay" id="drawer-overlay"></div>
<div class="bottom-drawer" id="bottom-drawer">
  <div class="drawer-handle"></div>
  <div class="drawer-header">
    <h2 class="drawer-title" id="drawer-title">Nueva Invitación</h2>
    <button class="drawer-close" id="drawer-close">✕</button>
  </div>
  <div class="drawer-body" id="drawer-body"></div>
</div>

<!-- ─── MODAL: código de invitación ──────────────────────────────────────── -->
<div class="modal-overlay" id="modal-overlay" style="display:none">
  <div class="modal-card" id="modal-card">
    <button class="modal-close" id="modal-close">✕</button>
    <div class="modal-body" id="modal-body"></div>
  </div>
</div>

<script src="/static/residente/js/residente.js"></script>
</body>
</html>
