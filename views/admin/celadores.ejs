<%- include('partials/head') %>
</head>
<body class="admin-layout">
<%- include('partials/nav') %>
<main class="main-content">
  <header class="page-header">
    <div>
      <h1 class="page-title">Celadores</h1>
      <p class="page-subtitle" id="sub-count">Cargando…</p>
    </div>
    <button class="btn-primary" id="btn-nuevo">
      <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" fill="none" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
      Nuevo celador
    </button>
  </header>

  <div class="table-wrapper">
    <table class="data-table">
      <thead>
        <tr><th>Nombre</th><th>Email</th><th>Último acceso</th><th>Estado</th><th>Acciones</th></tr>
      </thead>
      <tbody id="celadores-tbody">
        <tr><td colspan="5" class="table-loading">Cargando…</td></tr>
      </tbody>
    </table>
  </div>
</main>

<div class="drawer-overlay" id="drawer-overlay"></div>
<aside class="drawer" id="drawer-celador">
  <div class="drawer-header">
    <h2 class="drawer-title" id="drawer-title">Nuevo Celador</h2>
    <button class="drawer-close" id="drawer-close">✕</button>
  </div>
  <div class="drawer-body">
    <form id="form-celador">
      <input type="hidden" id="c-edit-id">
      <div class="form-field"><label>Nombre *</label><input type="text" id="c-nombre" required></div>
      <div class="form-field"><label>Email *</label><input type="email" id="c-email" required></div>
      <div class="form-field" id="field-c-estado" style="display:none">
        <label>Estado del celador</label>
        <select id="c-activo">
          <option value="true">Activo</option>
          <option value="false">Desactivado</option>
        </select>
      </div>
      <div id="c-form-error" class="form-error" style="display:none"></div>
      <button type="submit" class="btn-primary btn-block">Guardar</button>
    </form>
  </div>
</aside>

<script src="/static/admin/js/admin-common.js"></script>
<script src="/static/admin/js/celadores.js"></script>
</body>
</html>
