<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> — SGAR</title>
  <meta name="description" content="Sistema de Gestión de Acceso Residencial — Panel de administración">
  <link rel="icon" type="image/svg+xml" href="/static/shared/img/app-icon.svg">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    :root {
      --acento: <%= defaultColor %>;
      --acento-dark: color-mix(in srgb, var(--acento) 75%, #04070f);
    }
    *, *::before, *::as { box-sizing: border-box; }
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: 'Inter', system-ui, -apple-system, sans-serif;
      min-height: 100vh;
      background: #eef1f7;
      color: #101828;
    }

    .screen {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 28px;
    }

    .login-shell {
      width: 100%;
      max-width: 980px;
      min-height: 620px;
      display: flex;
      background: #fff;
      border-radius: 26px;
      overflow: hidden;
      box-shadow: 0 30px 70px -20px rgba(16,24,40,.35), 0 10px 24px -8px rgba(16,24,40,.12);
      animation: riseIn .6s cubic-bezier(.16,1,.3,1) both;
    }
    @keyframes riseIn {
      0% { opacity: 0; transform: translateY(22px) scale(.98); }
      100% { opacity: 1; transform: translateY(0) scale(1); }
    }

    /* ─── LEFT PANEL ─────────────────────────────────────────────── */
    .panel-visual {
      flex: 1.05;
      position: relative;
      background-image: url('/static/shared/img/hero-illustration.svg');
      background-size: cover;
      background-position: center;
      color: #fff;
      padding: 46px 42px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      min-width: 0;
      overflow: hidden;
    }
    .panel-visual::before {
      content: '';
      position: absolute; inset: 0;
      background: linear-gradient(160deg, color-mix(in srgb, var(--acento) 40%, transparent) 0%, color-mix(in srgb, var(--acento-dark) 55%, transparent) 100%);
      pointer-events: none;
    }
    .panel-visual::after {
      content: '';
      position: absolute; inset: 0;
      background: linear-gradient(180deg, rgba(4,8,20,.18) 0%, rgba(4,8,20,.02) 32%, rgba(4,8,20,.62) 100%);
      pointer-events: none;
    }
    .panel-visual > * { position: relative; z-index: 1; }

    .pv-brand { display: flex; align-items: center; gap: 12px; }
    .pv-brand-icon {
      width: 46px; height: 46px;
      border-radius: 13px;
      background: rgba(255,255,255,.14);
      border: 1px solid rgba(255,255,255,.28);
      backdrop-filter: blur(6px);
      display: flex; align-items: center; justify-content: center;
      flex-shrink: 0;
    }
    .pv-brand-icon svg { width: 24px; height: 24px; }
    .pv-brand-text { line-height: 1.2; }
    .pv-brand-text strong { display: block; font-size: 19px; font-weight: 800; letter-spacing: -.2px; }
    .pv-brand-text span   { display: block; font-size: 10.5px; letter-spacing: .4px; color: rgba(255,255,255,.7); font-weight: 600; margin-top: 1px; }

    .pv-callout {
      background: rgba(15,20,40,.55);
      backdrop-filter: blur(10px);
      border: 1px solid rgba(255,255,255,.14);
      border-radius: 18px;
      padding: 20px 22px;
    }
    .pv-callout-icon {
      width: 38px; height: 38px;
      border-radius: 11px;
      background: rgba(255,255,255,.16);
      display: flex; align-items: center; justify-content: center;
      margin-bottom: 14px;
    }
    .pv-callout-icon svg { width: 19px; height: 19px; }
    .pv-callout h3 { font-size: 16.5px; font-weight: 700; letter-spacing: -.2px; margin-bottom: 6px; }
    .pv-callout p  { font-size: 13px; line-height: 1.55; color: rgba(255,255,255,.75); }

    /* ─── RIGHT PANEL ────────────────────────────────────────────── */
    .panel-form {
      flex: 1;
      padding: 52px 52px 40px;
      display: flex;
      flex-direction: column;
      justify-content: center;
      min-width: 0;
    }
    .form-inner { width: 100%; max-width: 340px; margin: 0 auto; }

    .pf-avatar {
      width: 62px; height: 62px;
      border-radius: 50%;
      background: var(--acento-bg, #eff6ff);
      background: color-mix(in srgb, var(--acento) 10%, white);
      display: flex; align-items: center; justify-content: center;
      margin: 0 auto 18px;
    }
    .pf-avatar svg { width: 28px; height: 28px; color: var(--acento); }

    .pf-title    { text-align: center; font-size: 23px; font-weight: 800; letter-spacing: -.3px; color: #101828; }
    .pf-subtitle { text-align: center; font-size: 13.5px; color: #66708a; margin-top: 5px; margin-bottom: 30px; }

    #error-msg {
      display: none;
      background: #fef2f2;
      border: 1px solid #fecaca;
      color: #b91c1c;
      border-radius: 10px;
      padding: 11px 13px;
      font-size: 13px;
      font-weight: 500;
      margin-bottom: 18px;
      animation: shakeIn .4s ease;
    }
    @keyframes shakeIn {
      0%   { transform: translateX(-8px); opacity: 0; }
      25%  { transform: translateX(6px); } 50% { transform: translateX(-4px); }
      75%  { transform: translateX(2px); } 100% { transform: translateX(0); opacity: 1; }
    }

    .form-group { position: relative; margin-bottom: 14px; }
    .input-wrap { position: relative; }
    .input-wrap .icon-l {
      position: absolute; left: 14px; top: 50%; transform: translateY(-50%);
      width: 17px; height: 17px; color: #98a2b3; pointer-events: none;
    }
    .input-wrap:focus-within .icon-l { color: var(--acento); }

    .form-input {
      width: 100%;
      padding: 12px 14px 12px 42px;
      background: #f9fafb;
      border: 1.5px solid #e7eaf2;
      border-radius: 11px;
      color: #101828;
      font-size: 14px;
      font-family: 'Inter', system-ui, sans-serif;
      outline: none;
    }
    .form-input::placeholder { color: #a6adba; }
    .form-input:focus {
      border-color: var(--acento);
      background: #fff;
      box-shadow: 0 0 0 3px color-mix(in srgb, var(--acento) 14%, transparent);
    }
    .pwd-toggle {
      position: absolute; right: 12px; top: 50%; transform: translateY(-50%);
      background: none; border: none; cursor: pointer;
      color: #98a2b3; padding: 4px; display: flex;
    }
    .pwd-toggle:hover { color: #66708a; }
    .pwd-toggle svg { width: 17px; height: 17px; }

    .form-meta {
      display: flex; align-items: center; justify-content: space-between;
      margin: 14px 0 22px;
      font-size: 12.5px;
    }
    .form-meta label { display: flex; align-items: center; gap: 6px; color: #66708a; cursor: pointer; user-select: none; }
    .form-meta input[type="checkbox"] { accent-color: var(--acento); width: 14px; height: 14px; }
    .form-meta a { color: var(--acento); text-decoration: none; font-weight: 600; }
    .form-meta a:hover { text-decoration: underline; }

    .btn-login {
      width: 100%;
      padding: 13px 24px;
      background: linear-gradient(135deg, var(--acento) 0%, var(--acento-dark) 100%);
      color: #fff; border: none; border-radius: 11px;
      font-size: 14.5px; font-weight: 700;
      font-family: 'Inter', sans-serif;
      cursor: pointer;
      display: flex; align-items: center; justify-content: center; gap: 8px;
      box-shadow: 0 10px 22px -6px color-mix(in srgb, var(--acento) 55%, transparent);
      position: relative;
    }
    .btn-login svg { width: 17px; height: 17px; }
    .btn-login:hover { transform: translateY(-1px); box-shadow: 0 14px 26px -6px color-mix(in srgb, var(--acento) 62%, transparent); }
    .btn-login:active { transform: translateY(0); }
    .btn-login:disabled { opacity: .55; cursor: not-allowed; transform: none; }
    .btn-login.loading { color: transparent; pointer-events: none; }
    .btn-login.loading::after {
      content: ''; position: absolute; width: 18px; height: 18px;
      border: 2.5px solid rgba(255,255,255,.35); border-top-color: #fff;
      border-radius: 50%; animation: spin .6s linear infinite;
    }
    @keyframes spin { to { transform: rotate(360deg); } }

    .divider { display: flex; align-items: center; gap: 12px; margin: 26px 0 18px; }
    .divider::before, .divider::after { content: ''; flex: 1; height: 1px; background: #e7eaf2; }
    .divider span { font-size: 11.5px; color: #98a2b3; font-weight: 500; }

    .oauth-row { display: flex; gap: 10px; }
    .btn-oauth {
      flex: 1;
      display: flex; align-items: center; justify-content: center; gap: 8px;
      padding: 10px 14px;
      border: 1.5px solid #e7eaf2;
      border-radius: 11px;
      background: #fff;
      font-size: 13px; font-weight: 600; color: #344054;
      cursor: pointer;
    }
    .btn-oauth:hover { background: #f9fafb; border-color: #d0d5dd; }
    .btn-oauth svg { width: 17px; height: 17px; flex-shrink: 0; }

    .pf-footer { text-align: center; font-size: 11.5px; color: #98a2b3; margin-top: 30px; }

    @media (max-width: 860px) {
      .panel-visual { display: none; }
      .login-shell { max-width: 440px; }
      .panel-form { padding: 44px 32px; }
    }
  </style>
</head>
<body>

  <div class="screen">
    <div class="login-shell">

      <!-- ── LEFT: visual panel ── -->
      <div class="panel-visual">
        <div class="pv-brand">
          <div class="pv-brand-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.8" stroke-linejoin="round">
              <path d="M12 2.4 19.5 5v6.2c0 5.1-3.4 9.2-7.5 10.4-4.1-1.2-7.5-5.3-7.5-10.4V5L12 2.4z"/>
              <path d="M12 8 8.6 10.7v4.7h2.1v-3.1h2.6v3.1h2.1v-4.7L12 8z" fill="#fff" stroke="none"/>
            </svg>
          </div>
          <div class="pv-brand-text">
            <strong>SGAR</strong>
            <span>SISTEMA DE GESTIÓN DE&nbsp;ACCESO&nbsp;RESIDENCIAL</span>
          </div>
        </div>

        <div class="pv-callout">
          <div class="pv-callout-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
          </div>
          <h3>Seguridad y control para tu comunidad</h3>
          <p>Gestiona el acceso de residentes, visitantes y personal de forma segura y eficiente, todo desde un solo panel.</p>
        </div>
      </div>

      <!-- ── RIGHT: form panel ── -->
      <div class="panel-form">
        <div class="form-inner">
          <div class="pf-avatar">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          </div>
          <h1 class="pf-title">Bienvenido</h1>
          <p class="pf-subtitle">Inicia sesión para continuar</p>

          <div id="error-msg"></div>

          <div class="form-group">
            <div class="input-wrap">
              <svg class="icon-l" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
              <input class="form-input" type="email" id="email" placeholder="Correo electrónico" autocomplete="email">
            </div>
          </div>

          <div class="form-group" style="margin-bottom: 22px;">
            <div class="input-wrap">
              <svg class="icon-l" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
              <input class="form-input" type="password" id="password" placeholder="Contraseña" autocomplete="current-password" style="padding-right:40px;">
              <button type="button" class="pwd-toggle" id="pwd-toggle" tabindex="-1">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
              </button>
            </div>
          </div>

          <button class="btn-login" id="btn-login" style="margin-top: 6px;">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><polyline points="10 17 15 12 10 7"/><line x1="15" y1="12" x2="3" y2="12"/></svg>
            Iniciar sesión
          </button>

          <p class="pf-footer">© <%= new Date().getFullYear() %> SGAR. Todos los derechos reservados.</p>
        </div>
      </div>

    </div>
  </div>

  <script>
    const btn      = document.getElementById('btn-login');
    const errEl    = document.getElementById('error-msg');
    const emailEl  = document.getElementById('email');
    const pwdEl    = document.getElementById('password');
    const pwdToggle = document.getElementById('pwd-toggle');

    pwdToggle.addEventListener('click', () => {
      const isPwd = pwdEl.type === 'password';
      pwdEl.type = isPwd ? 'text' : 'password';
      pwdToggle.innerHTML = isPwd
        ? '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17.94 17.94A10.94 10.94 0 0 1 12 20c-7 0-11-8-11-8a18.6 18.6 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>'
        : '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>';
    });

    async function doLogin() {
      const email    = emailEl.value.trim();
      const password = pwdEl.value;
      if (!email || !password) { showErr('Completa todos los campos'); return; }

      btn.classList.add('loading');
      btn.disabled = true;
      errEl.style.display = 'none';

      try {
        const res = await fetch('/api/auth/login', {
          method:  'POST',
          headers: { 'Content-Type': 'application/json' },
          body:    JSON.stringify({ email, password }),
        });
        const data = await res.json();

        if (!data.success) { showErr(data.message || 'Error al iniciar sesión'); return; }

        localStorage.setItem('sgar_token', data.data.token);
        localStorage.setItem('sgar_user',  JSON.stringify(data.data.user));
        if (data.data.tenantConfig) {
          localStorage.setItem('sgar_tenant', JSON.stringify(data.data.tenantConfig));
        }

        const rol = data.data.user.rol;
        if (rol === 'celador')        { window.location.href = '/porteria'; }
        else if (rol === 'residente') { window.location.href = '/residente'; }
        else                          { window.location.href = '/admin/dashboard'; }

      } catch (e) {
        showErr('Error de conexión con el servidor');
      } finally {
        btn.classList.remove('loading');
        btn.disabled = false;
      }
    }

    function showErr(msg) {
      errEl.textContent    = msg;
      errEl.style.display  = 'block';
      errEl.style.animation = 'none';
      errEl.offsetHeight;
      errEl.style.animation = '';
    }

    btn.addEventListener('click', doLogin);
    [emailEl, pwdEl].forEach(el =>
      el.addEventListener('keydown', (e) => { if (e.key === 'Enter') doLogin(); })
    );
  </script>
</body>
</html>
