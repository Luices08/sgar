<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> — SGAR</title>
  <meta name="description" content="Sistema de Gestión de Acceso Residencial — Panel de administración">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    :root {
      --acento: <%= defaultColor %>;
      --acento-h: 230;
      --acento-s: 60%;
      --acento-l: 28%;
    }
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: 'Inter', system-ui, -apple-system, sans-serif;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      background: #0a0a1a;
      overflow: hidden;
      position: relative;
    }

    /* ─── ANIMATED BACKGROUND ──────────────────────────────────── */
    .bg-mesh {
      position: fixed; inset: 0; z-index: 0;
      background:
        radial-gradient(ellipse 80% 60% at 20% 30%, hsla(var(--acento-h), 70%, 35%, .35) 0%, transparent 60%),
        radial-gradient(ellipse 60% 80% at 80% 70%, hsla(260, 60%, 30%, .3) 0%, transparent 60%),
        radial-gradient(ellipse 70% 50% at 50% 50%, hsla(200, 50%, 20%, .2) 0%, transparent 50%),
        linear-gradient(160deg, #0a0a1a 0%, #111132 50%, #0a0a1a 100%);
      animation: meshShift 12s ease-in-out infinite alternate;
    }
    @keyframes meshShift {
      0%   { background-position: 0% 0%, 100% 100%, 50% 50%, 0% 0%; }
      100% { background-position: 30% 20%, 70% 80%, 60% 40%, 0% 0%; }
    }

    /* Floating particles */
    .particles {
      position: fixed; inset: 0; z-index: 1; pointer-events: none;
      overflow: hidden;
    }
    .particle {
      position: absolute;
      width: 2px; height: 2px;
      background: rgba(255,255,255,.15);
      border-radius: 50%;
      animation: float linear infinite;
    }
    @keyframes float {
      0%   { transform: translateY(100vh) scale(0); opacity: 0; }
      10%  { opacity: 1; }
      90%  { opacity: 1; }
      100% { transform: translateY(-10vh) scale(1); opacity: 0; }
    }

    /* ─── GRID PATTERN OVERLAY ─────────────────────────────────── */
    .grid-overlay {
      position: fixed; inset: 0; z-index: 1; pointer-events: none;
      background-image:
        linear-gradient(rgba(255,255,255,.02) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255,255,255,.02) 1px, transparent 1px);
      background-size: 60px 60px;
      mask-image: radial-gradient(ellipse 70% 70% at 50% 50%, black 30%, transparent 70%);
    }

    /* ─── MAIN CONTAINER ───────────────────────────────────────── */
    .login-container {
      position: relative; z-index: 10;
      width: 100%;
      max-width: 420px;
      padding: 20px;
      animation: slideUp .7s cubic-bezier(.16,1,.3,1) both;
    }
    @keyframes slideUp {
      0% { opacity: 0; transform: translateY(30px) scale(.97); }
      100% { opacity: 1; transform: translateY(0) scale(1); }
    }

    /* ─── BRAND ─────────────────────────────────────────────────── */
    .brand {
      text-align: center;
      margin-bottom: 36px;
      animation: fadeIn .8s .15s both;
    }
    @keyframes fadeIn { 0% { opacity: 0; } 100% { opacity: 1; } }

    .brand-logo {
      width: 64px; height: 64px;
      border-radius: 18px;
      background: linear-gradient(135deg, var(--acento) 0%, hsl(260, 50%, 40%) 100%);
      display: inline-flex;
      align-items: center; justify-content: center;
      margin-bottom: 18px;
      box-shadow:
        0 0 40px hsla(var(--acento-h), 70%, 40%, .3),
        0 8px 32px rgba(0,0,0,.4);
      position: relative;
    }
    .brand-logo::after {
      content: '';
      position: absolute; inset: -3px;
      border-radius: 20px;
      background: linear-gradient(135deg, hsla(var(--acento-h), 70%, 60%, .4), transparent 50%);
      z-index: -1;
      filter: blur(1px);
    }
    .brand-logo svg { width: 30px; height: 30px; fill: #fff; filter: drop-shadow(0 2px 4px rgba(0,0,0,.2)); }

    .brand h1 {
      font-size: 28px; font-weight: 800;
      background: linear-gradient(135deg, #fff 30%, rgba(255,255,255,.6) 100%);
      -webkit-background-clip: text; -webkit-text-fill-color: transparent;
      background-clip: text;
      letter-spacing: -.5px;
    }
    .brand p {
      font-size: 14px; color: rgba(255,255,255,.4);
      margin-top: 6px; font-weight: 400;
      letter-spacing: .3px;
    }

    /* ─── GLASS CARD ───────────────────────────────────────────── */
    .glass-card {
      background: rgba(255,255,255,.06);
      backdrop-filter: blur(24px) saturate(1.4);
      -webkit-backdrop-filter: blur(24px) saturate(1.4);
      border: 1px solid rgba(255,255,255,.1);
      border-radius: 20px;
      padding: 36px 32px 32px;
      box-shadow:
        0 24px 48px rgba(0,0,0,.3),
        inset 0 1px 0 rgba(255,255,255,.08);
      animation: cardIn .7s .2s cubic-bezier(.16,1,.3,1) both;
    }
    @keyframes cardIn {
      0% { opacity: 0; transform: translateY(16px); }
      100% { opacity: 1; transform: translateY(0); }
    }

    /* ─── FORM FIELDS ──────────────────────────────────────────── */
    .form-group {
      position: relative;
      margin-bottom: 22px;
    }
    .form-group label {
      display: block;
      font-size: 12px; font-weight: 600;
      text-transform: uppercase;
      letter-spacing: .8px;
      color: rgba(255,255,255,.45);
      margin-bottom: 8px;
      transition: color .2s;
    }
    .form-group:focus-within label {
      color: rgba(255,255,255,.7);
    }

    .input-wrap {
      position: relative;
    }
    .input-wrap .icon {
      position: absolute; left: 14px; top: 50%; transform: translateY(-50%);
      width: 18px; height: 18px;
      color: rgba(255,255,255,.25);
      pointer-events: none;
      transition: color .2s;
    }
    .input-wrap:focus-within .icon {
      color: rgba(255,255,255,.5);
    }

    .form-input {
      width: 100%;
      padding: 13px 16px 13px 44px;
      background: rgba(255,255,255,.06);
      border: 1px solid rgba(255,255,255,.1);
      border-radius: 12px;
      color: #fff;
      font-size: 15px;
      font-family: 'Inter', system-ui, sans-serif;
      outline: none;
      transition: all .25s ease;
    }
    .form-input::placeholder {
      color: rgba(255,255,255,.2);
    }
    .form-input:focus {
      border-color: hsla(var(--acento-h), 70%, 55%, .6);
      background: rgba(255,255,255,.09);
      box-shadow: 0 0 0 3px hsla(var(--acento-h), 70%, 55%, .12);
    }

    /* ─── BUTTON ────────────────────────────────────────────────── */
    .btn-login {
      width: 100%;
      padding: 14px 24px;
      background: linear-gradient(135deg, var(--acento) 0%, hsl(260, 50%, 40%) 100%);
      color: #fff;
      border: none;
      border-radius: 12px;
      font-size: 15px;
      font-weight: 700;
      font-family: 'Inter', system-ui, sans-serif;
      cursor: pointer;
      position: relative;
      overflow: hidden;
      transition: all .3s ease;
      margin-top: 6px;
      letter-spacing: .3px;
    }
    .btn-login::before {
      content: '';
      position: absolute; inset: 0;
      background: linear-gradient(135deg, rgba(255,255,255,.15) 0%, transparent 50%);
      opacity: 0;
      transition: opacity .3s;
    }
    .btn-login:hover {
      transform: translateY(-1px);
      box-shadow: 0 8px 24px hsla(var(--acento-h), 70%, 40%, .35);
    }
    .btn-login:hover::before { opacity: 1; }
    .btn-login:active { transform: translateY(0); }
    .btn-login:disabled {
      opacity: .5; cursor: not-allowed;
      transform: none; box-shadow: none;
    }

    /* Loading spinner in button */
    .btn-login.loading {
      pointer-events: none; color: transparent;
    }
    .btn-login.loading::after {
      content: '';
      position: absolute;
      width: 20px; height: 20px;
      border: 2px solid rgba(255,255,255,.3);
      border-top-color: #fff;
      border-radius: 50%;
      left: 50%; top: 50%;
      transform: translate(-50%, -50%);
      animation: spin .6s linear infinite;
    }
    @keyframes spin { to { transform: translate(-50%, -50%) rotate(360deg); } }

    /* ─── ERROR MESSAGE ────────────────────────────────────────── */
    #error-msg {
      display: none;
      background: rgba(229, 62, 62, .12);
      border: 1px solid rgba(229, 62, 62, .25);
      color: #ff8a8a;
      border-radius: 12px;
      padding: 12px 14px;
      font-size: 13px;
      font-weight: 500;
      margin-bottom: 18px;
      animation: shakeIn .4s ease;
    }
    @keyframes shakeIn {
      0%   { transform: translateX(-8px); opacity: 0; }
      25%  { transform: translateX(6px); }
      50%  { transform: translateX(-4px); }
      75%  { transform: translateX(2px); }
      100% { transform: translateX(0); opacity: 1; }
    }

    /* ─── FOOTER ────────────────────────────────────────────────── */
    .footer-note {
      text-align: center;
      font-size: 12px;
      color: rgba(255,255,255,.18);
      margin-top: 28px;
      font-weight: 400;
      letter-spacing: .3px;
    }

    /* ─── RESPONSIVE ────────────────────────────────────────────── */
    @media (max-width: 480px) {
      .glass-card { padding: 28px 22px 24px; border-radius: 16px; }
      .brand h1   { font-size: 24px; }
      .brand-logo { width: 56px; height: 56px; border-radius: 15px; }
    }
  </style>
</head>
<body>

  <!-- Animated background -->
  <div class="bg-mesh"></div>
  <div class="grid-overlay"></div>
  <div class="particles" id="particles"></div>

  <div class="login-container">
    <!-- Brand -->
    <div class="brand">
      <div class="brand-logo">
        <svg viewBox="0 0 24 24"><path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4z"/></svg>
      </div>
      <h1>SGAR</h1>
      <p>Sistema de Gestión de Acceso Residencial</p>
    </div>

    <!-- Login card -->
    <div class="glass-card">
      <div id="error-msg"></div>

      <div class="form-group">
        <label for="email">Correo electrónico</label>
        <div class="input-wrap">
          <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
          </svg>
          <input class="form-input" type="email" id="email" placeholder="admin@ejemplo.com" autocomplete="email">
        </div>
      </div>

      <div class="form-group">
        <label for="password">Contraseña</label>
        <div class="input-wrap">
          <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>
          </svg>
          <input class="form-input" type="password" id="password" placeholder="••••••••" autocomplete="current-password">
        </div>
      </div>

      <button class="btn-login" id="btn-login">Iniciar sesión</button>
    </div>

    <p class="footer-note">SGAR · ADSO 3142784</p>
  </div>

  <script>
    // Generate particles
    (function() {
      const container = document.getElementById('particles');
      for (let i = 0; i < 30; i++) {
        const p = document.createElement('div');
        p.className = 'particle';
        p.style.left = Math.random() * 100 + '%';
        p.style.animationDuration = (8 + Math.random() * 14) + 's';
        p.style.animationDelay = (Math.random() * 8) + 's';
        p.style.width = p.style.height = (1 + Math.random() * 2) + 'px';
        container.appendChild(p);
      }
    })();

    const btn      = document.getElementById('btn-login');
    const errEl    = document.getElementById('error-msg');
    const emailEl  = document.getElementById('email');
    const pwdEl    = document.getElementById('password');

    async function doLogin() {
      const email    = emailEl.value.trim();
      const password = pwdEl.value;
      if (!email || !password) { showErr('Completa todos los campos'); return; }

      btn.classList.add('loading');
      btn.disabled = true;
      errEl.style.display = 'none';

      try {
        const res = await fetch('/api/auth/login', {
          method:  'POST',
          headers: { 'Content-Type': 'application/json' },
          body:    JSON.stringify({ email, password }),
        });
        const data = await res.json();

        if (!data.success) { showErr(data.message || 'Error al iniciar sesión'); return; }

        // Guardar token y config en localStorage
        localStorage.setItem('sgar_token', data.data.token);
        localStorage.setItem('sgar_user',  JSON.stringify(data.data.user));
        if (data.data.tenantConfig) {
          localStorage.setItem('sgar_tenant', JSON.stringify(data.data.tenantConfig));
        }

        // Redirigir según rol
        const rol = data.data.user.rol;
        if (rol === 'celador')   { window.location.href = '/porteria'; }
        else if (rol === 'residente') { window.location.href = '/residente'; }
        else                     { window.location.href = '/admin/dashboard'; }

      } catch (e) {
        showErr('Error de conexión con el servidor');
      } finally {
        btn.classList.remove('loading');
        btn.disabled = false;
      }
    }

    function showErr(msg) {
      errEl.textContent    = msg;
      errEl.style.display  = 'block';
      // Re-trigger animation
      errEl.style.animation = 'none';
      errEl.offsetHeight;
      errEl.style.animation = '';
    }

    btn.addEventListener('click', doLogin);
    [emailEl, pwdEl].forEach(el =>
      el.addEventListener('keydown', (e) => { if (e.key === 'Enter') doLogin(); })
    );
  </script>
</body>
</html>
